{
  # Match both HTTP and HTTPS on any local domain
  :80 {
    redir https://{host}{uri} permanent
  }

  akaiv.localhost, *.akaiv.localhost, https://akaiv.localhost {
    tls internal

    @static path /build/*, /favicon.ico, /robots.txt, /storage/*

    handle @static {
      root * /var/www/public
      file_server
      header Cache-Control "public, max-age=31536000, immutable"
    }

    header {
      X-Content-Type-Options  nosniff
      X-Frame-Options         DENY
      Referrer-Policy         strict-origin-when-cross-origin
      Permissions-Policy      "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
      Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
      Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss: ws:; frame-ancestors 'none'; form-action 'self'; base-uri 'self';"
    }

    root * /var/www/public
    php_fastcgi php:9000 {
      trusted_proxies static private_ranges
    }
    encode zstd gzip
    file_server
  }
}
